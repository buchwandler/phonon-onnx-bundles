{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {"minimum": 1, "type": "integer"},
          "path": {"type": "string"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
        },
        "required": ["path", "bytes", "sha256"],
        "type": "object"
      },
      "type": "array"
    },
    "exporter": {"type": "object"},
    "license": {
      "additionalProperties": false,
      "properties": {
        "spdx": {"enum": ["CC-BY-NC-4.0", "Apache-2.0"]},
        "uri": {"format": "uri", "type": "string"},
        "legalcode_uri": {"format": "uri", "type": "string"},
        "commercial_use": {"type": "boolean"},
        "restrictions": {"items": {"type": "string"}, "type": "array"},
        "attribution_path": {"const": "ATTRIBUTION.md"},
        "warranty_disclaimer_section": {"type": "string"}
      },
      "required": ["spdx", "uri", "commercial_use", "restrictions", "attribution_path"],
      "allOf": [
        {
          "if": {"properties": {"spdx": {"const": "CC-BY-NC-4.0"}}, "required": ["spdx"]},
          "then": {
            "properties": {
              "uri": {"const": "https://creativecommons.org/licenses/by-nc/4.0/"},
              "legalcode_uri": {"const": "https://creativecommons.org/licenses/by-nc/4.0/legalcode.en"},
              "commercial_use": {"const": false},
              "warranty_disclaimer_section": {"const": "Section 5"}
            },
            "required": ["legalcode_uri", "warranty_disclaimer_section"]
          }
        }
      ],
      "type": "object"
    },
    "model_key": {"type": "string"},
    "modifications": {
      "additionalProperties": false,
      "properties": {
        "modified": {"const": true},
        "modification_notice": {"minLength": 1, "type": "string"},
        "precision": {"enum": ["fp32", "fp16", "q8", "q4"]},
        "quantization": {"enum": ["q8", "q4", null]}
      },
      "required": ["modified", "modification_notice", "precision", "quantization"],
      "type": "object"
    },
    "precision": {"enum": ["fp32", "q8", "q4", "fp16"]},
    "runtime": {"type": "object"},
    "schema_version": {"const": 2},
    "source": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {"minLength": 1, "type": "string"},
        "requested_revision": {"minLength": 1, "type": "string"},
        "resolved_revision": {"minLength": 7, "type": "string"},
        "uri": {"format": "uri", "type": "string"},
        "license": {"enum": ["CC-BY-NC-4.0", "Apache-2.0"]},
        "license_uri": {"format": "uri", "type": "string"},
        "license_legalcode_uri": {"format": "uri", "type": ["string", "null"]}
      },
      "required": ["repo_id", "requested_revision", "resolved_revision", "uri", "license", "license_uri", "license_legalcode_uri"],
      "allOf": [
        {
          "if": {"properties": {"license": {"const": "CC-BY-NC-4.0"}}, "required": ["license"]},
          "then": {"properties": {"license_legalcode_uri": {"const": "https://creativecommons.org/licenses/by-nc/4.0/legalcode.en"}}}
        }
      ],
      "type": "object"
    },
    "tag": {"type": "string"},
    "voices": {"type": "object"}
  },
  "required": ["schema_version", "tag", "model_key", "precision", "source", "exporter", "runtime", "voices", "license", "modifications", "assets"],
  "type": "object"
}
